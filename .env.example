# harness-catalog — .env의 본. 복사해서 채운다: cp .env.example .env && chmod 600 .env  (distribution D10)
# 값 생성: openssl rand -base64 32

# --- PostgreSQL (docker-compose*.yml) ---
POSTGRES_PASSWORD=
HC_DB_PASSWORD=
DEX_DB_PASSWORD=
# 호스트에 여는 포트(개발 compose만, 127.0.0.1 바인딩)
POSTGRES_PORT=5432

# --- Dex ---
DEX_PORT=5556
# issuer = 토큰의 iss. 개발은 로컬, 운영은 프록시 뒤 공개 URL(우산 §6-3: https://mini.tail2f9fe3.ts.net/dex)
DEX_ISSUER=http://localhost:5556/dex
# 기밀 클라이언트 ci-runner의 시크릿 (D5)
DEX_CI_RUNNER_SECRET=
# 레지스트리 공개 URL. Dex의 audience 클라이언트 id이기도 하다(docker/dex/config.yaml, public — 시크릿 없음)
HC_PUBLIC_URL=http://localhost:8000/mcp

# --- Synology LDAP (examples/synology-ldap/ 오버레이를 쓸 때만) ---
# LDAPS 기본. 평문 389로 되돌리려면 LDAP_HOST=192.168.3.95:389, LDAP_INSECURE_NO_SSL=true
LDAP_HOST=192.168.3.95:636
LDAP_INSECURE_NO_SSL=false
LDAP_INSECURE_SKIP_VERIFY=true
LDAP_BIND_DN=uid=admin,cn=users,dc=gyojunan,dc=synology,dc=me
LDAP_BIND_PW=
LDAP_USER_BASE_DN=cn=users,dc=gyojunan,dc=synology,dc=me
LDAP_GROUP_BASE_DN=cn=groups,dc=gyojunan,dc=synology,dc=me

# --- 레지스트리 설정값 여섯 (HC__ 접두, service P1에서 이름이 확정되면 채운다) ---
