# self-hosted 러너(mini) 루트의 .env 본. 러너(actions/runner)가 기동 때 이 파일을 읽어 잡 환경으로 넣는다(distribution D21).
# 이 파일은 러너 머신에만 두고(0600) 저장소에는 예시만 둔다. 채운 뒤 러너를 재기동한다. CI evals 자체는 git 호스트 변수 HARNESS_EVALS=true로 켠다.
# 각 하네스의 변수 이름은 Harbor 에이전트 구현이 읽는 그대로다(DESIGN §5.1). 돌릴 하네스(HARNESS_EVALS_AGENTS, 기본 "claude-code codex")의 것만 채우면 된다.

# --- claude-code: 구독(권장) 또는 API 키 ---
CLAUDE_CODE_OAUTH_TOKEN=          # claude setup-token
CLAUDE_FORCE_OAUTH=1
# ANTHROPIC_API_KEY=

# --- codex: API 키 또는 구독(auth.json) ---
# OPENAI_API_KEY=
CODEX_FORCE_AUTH_JSON=1           # 러너 사용자의 ~/.codex/auth.json 을 쓴다
# CODEX_AUTH_JSON_PATH=/Users/<runner-user>/.codex/auth.json

# --- cursor-cli · gemini-cli (목록에 넣을 때만) ---
# CURSOR_API_KEY=
# GEMINI_API_KEY=
# GEMINI_FORCE_OAUTH=

# --- Langfuse (harbor-langfuse 플러그인이 평가 결과를 남길 프로젝트) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # US는 https://us.cloud.langfuse.com, 셀프호스팅은 그 주소

# --- 카탈로그 CI가 비공개 코드 저장소를 받을 때(저장소 시크릿 대신 러너 환경으로 줄 수도 있다) ---
# HARNESS_CATALOG_DEPLOY_KEY=     # 보통은 저장소 시크릿으로 둔다(operations.md §1-5)
