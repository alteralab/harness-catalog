{
  "name": "harness-catalog-docs",
  "version": "0.0.0",
  "private": true,
  "description": "문서 사이트(Fumadocs + Next 정적 내보내기). 콘텐츠는 저장소의 docs/ 를 그대로 읽는다 — 복사하지 않는다.",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "prebuild": "node scripts/vendor-fonts.mjs && fumadocs-mdx",
    "build": "next build",
    "postbuild": "node scripts/after-build.mjs",
    "predev": "node scripts/vendor-fonts.mjs",
    "dev": "next dev",
    "serve": "node scripts/serve-out.mjs",
    "types:check": "next typegen && tsc --noEmit",
    "search:probe": "node scripts/search-probe.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.8",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
    "lucide-react": "1.60.0",
    "mermaid": "11.12.0",
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unist-util-visit": "5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "pretendard": "1.3.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "zbsearch": "4.0.1"
  }
}
