# harness-catalog — .env의 본. 복사해서 채운다: cp docker/.env.example docker/.env && chmod 600 docker/.env  (distribution D10)
# 값 생성: openssl rand -base64 32

# --- PostgreSQL (docker-compose*.yml) ---
POSTGRES_PASSWORD=
HC_DB_PASSWORD=
DEX_DB_PASSWORD=
# 호스트에 여는 포트(개발 compose만, 127.0.0.1 바인딩)
POSTGRES_PORT=5432

# --- Dex ---
DEX_PORT=5556
# issuer와 audience는 레지스트리 설정값(HC__OIDC_ISSUER·HC__PUBLIC_URL)에서 compose가 Dex에 같은 값으로 건넨다 — 따로 적지 않는다
# 기밀 클라이언트 ci-runner의 시크릿 (D5)
DEX_CI_RUNNER_SECRET=

# --- Synology LDAP (docker/synology-ldap/ 오버레이를 쓸 때만) ---
# 아래 값은 자리표시자다 — 자기 디렉터리의 주소와 DN으로 바꾼다.
# LDAPS 기본. 평문 389로 되돌리려면 LDAP_HOST=ldap.example.com:389, LDAP_INSECURE_NO_SSL=true
LDAP_HOST=ldap.example.com:636
LDAP_INSECURE_NO_SSL=false
LDAP_INSECURE_SKIP_VERIFY=true
LDAP_BIND_DN=uid=admin,cn=users,dc=example,dc=com
# 바인드 비밀번호는 SECRETS_DIR/ldap_bind_pw 파일(운영) 또는 아래 변수(개발)
LDAP_BIND_PW=
LDAP_USER_BASE_DN=cn=users,dc=example,dc=com
LDAP_GROUP_BASE_DN=cn=groups,dc=example,dc=com

# --- 레지스트리 설정값 (harness-catalog config docs가 만든 절; 운영 compose는 비밀 둘을 *_FILE로 받는다) ---
# 카탈로그 git 저장소 URL (deploy key로 fetch만 한다)
HC__CATALOG_REPO_URL=
# 읽기 전용 deploy key의 개인 키(PEM). 로컬 file:// 저장소면 빈 문자열
HC__GIT_DEPLOY_KEY=
# OIDC issuer URL (토큰의 iss, JWKS 발견)
HC__OIDC_ISSUER=
# 레지스트리 공개 URL = 토큰의 audience = RFC 9728 resource
HC__PUBLIC_URL=
# PostgreSQL 접속 문자열
HC__DATABASE_URL=
# 읽기 권한을 주는 디렉터리의 그룹 이름 — 환경값. 토큰의 groups에 이 이름이 있으면 reader다. Dex 설정의 그룹 이름과 같아야 한다
HC__READER_GROUP=harness-readers
# 주기 fetch 간격(초)
HC__FETCH_INTERVAL_SECONDS=60

# --- 검색 0.8.0 (§11 2026-10-19) — dense 임베딩 서비스. 기본값은 compose.yml(호스트 Ollama http://host.docker.internal:11434/api/embed). 끄려면 빈 값, TEI 면 http://<host>:<port>/embed
#HC__EMBED_URL=
#HC__EMBED_MODEL=hf.co/mykor/KURE-v1-gguf:BF16

# --- 관측 (distribution D20) — 레지스트리의 도구 호출 스팬을 OTLP로 내보낸다 ---
# 모든 배포에 맞는 수집기 주소는 없다 — 기본값은 비어 있고, 비면 스팬은 no-op으로 아무 데도 가지 않는다(§11 2026-10-20).
# 자기 수신처를 아래 줄에 적는다. 예시 셋:
#   Langfuse Cloud US   https://us.cloud.langfuse.com/api/public/otel
#   Langfuse Cloud EU   https://cloud.langfuse.com/api/public/otel
#   셀프호스트·Collector  https://<host>/api/public/otel  (OTel Collector면 http://<host>:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Langfuse는 Basic 인증: printf '%s:%s' "$LANGFUSE_PUBLIC_KEY" "$LANGFUSE_SECRET_KEY" | base64  →  Authorization=Basic <그 값>
# 운영 compose는 이 값을 환경이 아니라 비밀 파일 SECRETS_DIR/otlp_headers에서 읽는다(D10). 아래 변수는 개발·빠른 시작용
OTEL_EXPORTER_OTLP_HEADERS=
# Langfuse는 gRPC를 받지 않는다 — http/protobuf 고정
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# service.name은 코드 기본값 harness-catalog. 바꿀 일이 있으면 표준 변수 OTEL_SERVICE_NAME을 직접 준다

# --- 운영 compose (docker/compose.yml) ---
# 필수값(기본값 없음). 자기 레지스트리 주소를 적는다 — 태그는 v<판> 또는 그 태그 커밋의 짧은 SHA (git rev-parse --short v<판>)
REGISTRY_IMAGE=ghcr.io/<org>/harness-catalog:<판 태그 vX.Y.Z 또는 짧은 SHA>
# 문서 사이트 이미지(CI 가 레지스트리 이미지와 같은 태그로 올린다; deploy.sh 가 함께 바꾼다)
DOCS_IMAGE=ghcr.io/<org>/harness-catalog-docs:<tag>
REGISTRY_PORT=8000
# 비밀 파일 디렉토리(0700): git_deploy_key, database_url, postgres_password, hc_db_password, dex_db_password, dex_ci_runner_secret, otlp_headers(비면 무시), ldap_bind_pw
SECRETS_DIR=../secrets   # docker/.env 기준 상대 경로 → 저장소 루트의 secrets/ (scripts/make-secrets.sh secrets 가 만드는 곳)
# 프록시 뒤 hairpin: 레지스트리 컨테이너 안에서 공개 호스트 이름을 호스트의 IP로 푼다(synology-ldap 오버레이를 쓰면 필수 — 기본값 없음).
# 호스트 이름은 HC__PUBLIC_URL의 호스트와 같은 값, IP는 프록시가 듣는 주소(우리는 호스트의 tailscale IP).
HC_PUBLIC_HOSTNAME=registry.example.com
HC_HOST_TAILSCALE_IP=10.0.0.1
