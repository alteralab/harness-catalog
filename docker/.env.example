# harness-catalog — .env의 본. 복사해서 채운다: cp docker/.env.example docker/.env && chmod 600 docker/.env  (distribution D10)
# 값 생성: openssl rand -base64 32

# --- PostgreSQL (docker-compose*.yml) ---
POSTGRES_PASSWORD=
HC_DB_PASSWORD=
DEX_DB_PASSWORD=
# 호스트에 여는 포트(개발 compose만, 127.0.0.1 바인딩)
POSTGRES_PORT=5432

# --- Dex ---
DEX_PORT=5556
# issuer와 audience는 레지스트리 설정값(HC__OIDC_ISSUER·HC__PUBLIC_URL)에서 compose가 Dex에 같은 값으로 건넨다 — 따로 적지 않는다
# 기밀 클라이언트 ci-runner의 시크릿 (D5)
DEX_CI_RUNNER_SECRET=

# --- Synology LDAP (docker/synology-ldap/ 오버레이를 쓸 때만) ---
# LDAPS 기본. 평문 389로 되돌리려면 LDAP_HOST=192.168.3.95:389, LDAP_INSECURE_NO_SSL=true
LDAP_HOST=192.168.3.95:636
LDAP_INSECURE_NO_SSL=false
LDAP_INSECURE_SKIP_VERIFY=true
LDAP_BIND_DN=uid=admin,cn=users,dc=gyojunan,dc=synology,dc=me
# 바인드 비밀번호는 SECRETS_DIR/ldap_bind_pw 파일(운영) 또는 아래 변수(개발)
LDAP_BIND_PW=
LDAP_USER_BASE_DN=cn=users,dc=gyojunan,dc=synology,dc=me
LDAP_GROUP_BASE_DN=cn=groups,dc=gyojunan,dc=synology,dc=me

# --- 레지스트리 설정값 (harness-catalog config docs가 만든 절; 운영 compose는 비밀 둘을 *_FILE로 받는다) ---
# 카탈로그 git 저장소 URL (deploy key로 fetch만 한다)
HC__CATALOG_REPO_URL=
# 읽기 전용 deploy key의 개인 키(PEM). 로컬 file:// 저장소면 빈 문자열
HC__GIT_DEPLOY_KEY=
# OIDC issuer URL (토큰의 iss, JWKS 발견)
HC__OIDC_ISSUER=
# 레지스트리 공개 URL = 토큰의 audience = RFC 9728 resource
HC__PUBLIC_URL=
# PostgreSQL 접속 문자열
HC__DATABASE_URL=
# 주기 fetch 간격(초)
HC__FETCH_INTERVAL_SECONDS=60

# --- 관측 (선택, distribution D20) — 레지스트리의 도구 호출 스팬을 OTLP로 내보낸다. ENDPOINT가 비면 스팬은 no-op이다 ---
# Langfuse Cloud: https://cloud.langfuse.com/api/public/otel (EU) · https://us.cloud.langfuse.com/api/public/otel (US) · 셀프호스팅은 <host>/api/public/otel
OTEL_EXPORTER_OTLP_ENDPOINT=
# Langfuse는 Basic 인증: printf '%s:%s' "$LANGFUSE_PUBLIC_KEY" "$LANGFUSE_SECRET_KEY" | base64  →  Authorization=Basic <그 값>
# 운영 compose는 이 값을 환경이 아니라 비밀 파일 SECRETS_DIR/otlp_headers에서 읽는다(D10). 아래 변수는 개발·빠른 시작용
OTEL_EXPORTER_OTLP_HEADERS=
# Langfuse는 gRPC를 받지 않는다 — http/protobuf 고정
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# service.name은 코드 기본값 harness-catalog. 바꿀 일이 있으면 표준 변수 OTEL_SERVICE_NAME을 직접 준다

# --- 운영 compose (docker/compose.yml) ---
# 이미지 태그 = v<판> 태그 커밋의 짧은 SHA (git rev-parse --short v<판>)
REGISTRY_IMAGE=ds923plus.tail2f9fe3.ts.net:9443/alteralab/harness-catalog:<판 태그 vX.Y.Z 또는 짧은 SHA>
REGISTRY_PORT=8000
# 비밀 파일 디렉토리(0700): git_deploy_key, database_url, postgres_password, hc_db_password, dex_db_password, dex_ci_runner_secret, otlp_headers(비면 무시), ldap_bind_pw
SECRETS_DIR=../secrets   # docker/.env 기준 상대 경로 → 저장소 루트의 secrets/ (scripts/make-secrets.sh secrets 가 만드는 곳)
# 프록시 뒤 hairpin: 레지스트리 컨테이너 안에서 공개 호스트 이름을 호스트의 tailscale IP로 푼다(synology-ldap 오버레이)
HC_PUBLIC_HOSTNAME=alteraui-macmini.tail2f9fe3.ts.net
HC_HOST_TAILSCALE_IP=100.97.103.14
