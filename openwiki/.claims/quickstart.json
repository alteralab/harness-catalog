    {
      "id": "claim_04a81b7419d245f3bdf24ed3ac750ef5",
      "statement": "The OpenWiki update workflow serializes itself with `concurrency: openwiki-update` and `cancel-in-progress: true` so that overlapping merges cannot split the baseline commit, and checks out full history (`fetch-depth: 0`) because `openwiki code --update` diffs HEAD against the commit it last documented and a shallow clone hides that commit, producing an empty change summary.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L15-L18",
          "version": "repo-lines-v1:sha256:bf03e208964ea42937ed49a0c872ba37aea188909743adb51c0b6e1016f4db21:"
