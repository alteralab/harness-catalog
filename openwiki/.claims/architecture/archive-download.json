    {
      "id": "claim_bcffc465c9ad4bbdac6d5e785f61de59",
      "statement": "The route GET /mcp/archive/{name}/{tree}.tar carries the credential in a request header rather than the URL, answers every verification failure with an empty 403, maps not_found/unknown_version to 404 and input_limit to 413, re-raises other errors, and serves the cached tar with FileResponse plus Cache-Control: private, no-store.",
