    {
      "id": "claim_ddac44599239410498df2b7044cbc194",
      "statement": "Authorization is a pure function: any principal whose groups claim contains harness-readers may call all five read tools (list_skills, search_skills, load_skill, get_skill_file, get_skill_archive); otherwise the call is refused with error code not_a_member, and unknown tool names yield not_found. There is no distinction between human and machine principals.",
      "evidence": [
        {
          "resource": "repo://packages/core/src/harness_catalog_core/authz.py#L10-L35",
          "version": "repo-lines-v1:sha256:05a66f636909242ea198bd10680d8450ed3f89474eff4e46e661642ebc19f275:"
        }
      ]
    },
    {
      "id": "claim_126b26e681d54b0bad32c047853a7f9e",
      "statement": "Every tool call derives the principal from the verified token claims (sub, groups, azp or string aud), records the subject as the span attribute langfuse.user.id, and returns an isError tool result when authorization is denied.",
