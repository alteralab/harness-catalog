    {
      "id": "claim_523b08addbd743e8927b4fdcc1930a8e",
      "statement": "JwtTokenVerifier validates tokens against the issuer's JWKS (cached for 3600 s) and requires RS256/ES256 signatures, matching iss and aud, and the exp and sub claims, with clock leeway; it runs decoding in a worker thread.",
