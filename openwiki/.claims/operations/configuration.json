    {
      "id": "claim_f5eea3679d6344e4b8b5201da237eaf5",
      "statement": "The registry's configuration is exactly six HC__-prefixed settings: five required (catalog_repo_url, git_deploy_key, oidc_issuer, public_url, database_url) and fetch_interval_seconds with default 60 and a minimum of 1; the two secrets are SecretStr fields.",
      "evidence": [
        {
          "resource": "repo://packages/core/src/harness_catalog_core/settings.py#L36-L47",
          "version": "repo-lines-v1:sha256:61679b1194585c9ef43182d1dad133e5946562d36ec0277da5e38b586d35c97e:"
        }
      ]
    },
    {
      "id": "claim_61e41b0431ab4f79af32a48a2ce56d0b",
      "statement": "A before-validator rejects a trailing slash on oidc_issuer and public_url so that Dex (which uses the raw string as issuer and audience client id) and the registry (which strips it) can never diverge.",
