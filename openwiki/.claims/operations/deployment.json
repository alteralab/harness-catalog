    {
      "id": "claim_a85b6cf7c6784bf8a73c837e8bb8303b",
      "statement": "The image is multi-stage: a builder installs only the server package with uv from pyproject.toml, uv.lock and packages/, and the runtime stage adds git (required at 2.42 or newer for git archive --mtime), ca-certificates, openssh-client and the gitleaks binary and runs as a non-root user; .dockerignore keeps tests, docs, the docker/ directory, secrets, openwiki and developer tooling such as node_modules, graft and .claude out of the build context.",
      "evidence": [
